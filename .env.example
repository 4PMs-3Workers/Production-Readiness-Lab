DATABASE_URL=mysql+asyncmy://app_user:replace-with-local-password@127.0.0.1:3306/production_readiness_lab
MYSQL_TEST_URL=mysql+asyncmy://test_user:replace-with-test-password@127.0.0.1:3306
ENVIRONMENT=local
# Explicit acknowledgement of the database to seed; must match DATABASE_URL.
DEMO_SEED_DATABASE=production_readiness_lab
# Replace placeholders locally. Never commit the supplied passwords.
DEMO_ADMIN_PASSWORD=replace-with-local-admin-password
DEMO_STAFF_PASSWORD=replace-with-local-staff-password
DEMO_STUDENT_PASSWORD=replace-with-local-student-password
APPLICATION_ORIGIN=http://localhost:3000
COOKIE_SECRET=replace-with-random-cookie-secret
CSRF_SECRET=replace-with-independent-random-csrf-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN must remain unset: authentication cookies are host-only.
SESSION_LIFETIME_SECONDS=86400
LOGIN_MAX_BODY_BYTES=4096
LOGIN_IP_ATTEMPTS=30
LOGIN_EMAIL_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
LOGIN_STATE_MAX_ENTRIES=10000
PASSWORD_MAX_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=1
DB_POOL_TIMEOUT_SECONDS=0.5
DB_QUERY_TIMEOUT_SECONDS=1
DB_LOCK_TIMEOUT_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=3
READINESS_TIMEOUT_SECONDS=2
MAX_DEADLOCK_RETRIES=2
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=100
WORKER_GRACE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
ACCEPTED_SCHEMA_REVISIONS=20261017_2350_student_profile
# TRUSTED_GATEWAY_CIDRS=127.0.0.1/32
