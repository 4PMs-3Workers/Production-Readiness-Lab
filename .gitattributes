# Keep frontend formatting consistent between Windows checkouts and Linux CI.
/src/frontend/** text eol=lf
/src/frontend/public/** -text
/tests/frontend/** text eol=lf
/tests/containers/** text eol=lf
/tools/scripts/lint-frontend.mjs text eol=lf
/tools/scripts/start-frontend.ps1 text eol=lf
/eslint.config.mjs text eol=lf
/package.json text eol=lf
/package-lock.json text eol=lf
/.gitattributes text eol=lf
/.npmrc text eol=lf
/.nvmrc text eol=lf
/.prettierignore text eol=lf
/.prettierrc.json text eol=lf
/docs/tasks/frontend-bootstrap.md text eol=lf
/.github/workflows/frontend.yml text eol=lf
/docs/screenshots/frontend-bootstrap/*.png -text

# Deployment scripts are executed inside Linux containers.
/tools/deploy/** text eol=lf
/tools/backup/** text eol=lf
