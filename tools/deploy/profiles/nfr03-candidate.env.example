# Candidate only: validate capacity/topology and HTTP gateway acceptance before release.
# Merge these non-secret overrides into the separately managed runtime environment.
# If API and worker share that environment, include both pools in the DB budget.
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=0.75
DB_QUERY_TIMEOUT_SECONDS=1
REQUEST_TIMEOUT_SECONDS=3
