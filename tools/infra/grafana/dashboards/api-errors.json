{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "Static interpretation notes.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "The error rate is based on 5xx and incomplete API responses over all API requests. Empty request windows remain no data; a missing required API telemetry family is a separate gap."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP error rate by normalized route (5m)",
      "description": "No request series means insufficient data. Routes are finite OpenAPI templates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl:api_http_error_ratio:ratio5m",
          "instant": false,
          "legendFormat": "{{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API telemetry family gap",
      "description": "A target that is up but lacks the stdout queue-capacity family is a telemetry gap. No series is not an idle request count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "(up{job=\"api\"} == 1) unless on(job,instance) prl_telemetry_queue_capacity{service=\"api\",signal=\"stdout\"}",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "API request logs",
      "description": "Native OTLP event body is http.server.request; status, route, request ID and trace ID are structured metadata, not JSON or index labels.",
      "datasource": {
        "type": "loki",
        "uid": "prl-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "prl-loki"
          },
          "expr": "{service_name=\"api\",deployment_environment_name=\"demo\"} |= \"http.server.request\" | status >= 500 | keep route,method,status,error_code,request_id,trace_id",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": [
    "production-readiness",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "API errors",
  "uid": "prl-api-errors",
  "version": 1
}
