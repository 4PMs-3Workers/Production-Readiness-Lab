{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "Static interpretation notes.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "mode": "markdown",
        "content": "This view describes the local backup store and monitor. Empty or missing metrics mean unknown, not healthy. A manual backup can refresh the artifact without clearing a scheduled failure. Remote-copy unknown/not-configured is not delivery evidence; same-host monitoring does not cover a host outage."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Verified artifact age and configured RPO",
      "description": "Artifact age is unknown when no integrity-verified artifact is recorded. Compare the age with the configured RPO; the RPO line is a configured bound, not an availability promise.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "time() - prl_backup_last_verified_timestamp_seconds{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} artifact age",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_monitor_rpo_seconds{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} configured RPO",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Artifact integrity",
      "description": "No sample means unknown or no verified artifact. A value of 1 means an artifact integrity check succeeded; it does not prove application recovery.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_artifact_integrity_verified{environment=~\"$environment\",store=~\"$store\"}",
          "instant": true,
          "legendFormat": "integrity verified",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Not verified" }, "1": { "text": "Verified" } }, "type": "value" },
            { "options": { "match": "null", "result": { "text": "Unknown", "color": "gray" } }, "type": "special" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Application rehearsal",
      "description": "A verified artifact is separate from a successful application recovery rehearsal. Empty means no rehearsal evidence; it is not a pass.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_application_rehearsal_verified{environment=~\"$environment\",store=~\"$store\"}",
          "instant": true,
          "legendFormat": "rehearsal verified",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Not verified" }, "1": { "text": "Verified" } }, "type": "value" },
            { "options": { "match": "null", "result": { "text": "Unknown", "color": "gray" } }, "type": "special" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange" }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last scheduled job outcome",
      "description": "Shows the last completed scheduled operation only. Empty means no final scheduled report is available; check incomplete/missing alerts.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_scheduled_job_last_success{environment=~\"$environment\",store=~\"$store\"}",
          "instant": true,
          "legendFormat": "scheduled result",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "Failure" }, "1": { "text": "Success" } }, "type": "value" },
            { "options": { "match": "null", "result": { "text": "Unknown", "color": "gray" } }, "type": "special" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last scheduled job duration",
      "description": "Duration of the last completed scheduled job. A manual operation cannot replace this sample.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_scheduled_job_last_duration_seconds{environment=~\"$environment\",store=~\"$store\"}",
          "instant": true,
          "legendFormat": "scheduled duration",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backup job alerts",
      "description": "Only currently firing backup artifact/job alerts are shown. An empty vector is not evidence that the monitor target and rules are available.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "ALERTS{environment=~\"$environment\",store=~\"$store\",alertstate=\"firing\",alertname=~\"BackupArtifactMissing|BackupArtifactStale|BackupJobFailed|BackupJobIncomplete|BackupJobMissing\"}",
          "instant": false,
          "legendFormat": "{{alertname}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Backup store capacity",
      "description": "Free and total filesystem bytes are measurements, not a named-volume quota. The minimum-free metric is the producer's refusal threshold.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_store_free_bytes{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} free",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_store_total_bytes{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} total",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_minimum_free_bytes{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} minimum free",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Monitor collection freshness",
      "description": "Age is based on the exporter's last successful state read. Missing config/state or stale age is unknown and should be handled by the monitor alerts.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "time() - prl_backup_monitor_last_successful_state_read_timestamp_seconds{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} read age",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_monitor_stale_seconds{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{environment}} allowed age",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Remote copy verification",
      "description": "Unknown or not_configured means no producer has verified an off-host copy. Empty means unknown; a local artifact or local receiver does not prove remote delivery.",
      "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
          "editorMode": "code",
          "expr": "prl_backup_remote_copy_state{environment=~\"$environment\",store=~\"$store\"}",
          "instant": false,
          "legendFormat": "{{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["backup", "operations"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
        "definition": "label_values(prl_backup_monitor_state_valid, environment)",
        "hide": 0,
        "includeAll": false,
        "label": "Environment",
        "name": "environment",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(prl_backup_monitor_state_valid, environment)", "refId": "PrometheusVariableQueryEditor-Environment" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prl-prometheus" },
        "definition": "label_values(prl_backup_monitor_state_valid{environment=~\"$environment\"}, store)",
        "hide": 0,
        "includeAll": false,
        "label": "Store",
        "name": "store",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(prl_backup_monitor_state_valid{environment=~\"$environment\"}, store)", "refId": "PrometheusVariableQueryEditor-Store" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Backup health",
  "uid": "prl-backup-health",
  "version": 1
}
