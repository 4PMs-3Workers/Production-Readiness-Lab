  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "Static interpretation notes.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Missing targets, required metric families, or pipeline heartbeats are gaps. A missing loss counter is not proof of zero loss. Worker unit-1 queue gauges carry the _ratio suffix but remain absolute queue counts/capacities."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape targets",
      "description": "1 = scraped, 0 = target down. An absent target series is unknown and should be investigated.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=~\"api|collector|application-otel|loki-self|tempo-self|grafana-self|alertmanager-self|local-alert-receiver\"}",
          "instant": false,
          "legendFormat": "{{job}} {{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dropped / refused items (5m)",
      "description": "API drops plus pinned Collector refusal and receiver-processing failure counters for logs, metric points, and spans. Missing zero-valued families can be unmaterialized; check target health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(service,signal,reason) (increase(prl_telemetry_dropped_total[5m]))",
          "instant": false,
          "legendFormat": "{{service}} {{signal}} {{reason}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_refused_log_records{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector refused log records {{receiver}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_refused_metric_points{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector refused metric points {{receiver}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_refused_spans{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector refused spans {{receiver}}",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_failed_log_records{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector failed log records {{receiver}}",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_failed_metric_points{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector failed metric points {{receiver}}",
          "range": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(receiver) (increase(otelcol_receiver_failed_spans{job=\"collector\"}[5m]))",
          "instant": false,
          "legendFormat": "Collector failed spans {{receiver}}",
          "range": true,
          "refId": "G"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Export failures (5m)",
