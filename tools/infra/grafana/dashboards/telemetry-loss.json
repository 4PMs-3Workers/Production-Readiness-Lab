    {
      "id": 5,
      "type": "timeseries",
      "title": "API telemetry queues",
      "description": "Direct API registry names. Missing capacity while API is up is a telemetry gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_telemetry_queue_size{job=\"api\"}",
          "instant": false,
          "legendFormat": "API {{signal}} size",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_telemetry_queue_capacity{job=\"api\"}",
          "instant": false,
          "legendFormat": "API {{signal}} capacity",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker telemetry queues",
      "description": "Worker unit-1 gauges use _ratio-suffixed Prometheus names; values remain absolute counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_telemetry_queue_size_ratio{job=\"application-otel\",service_name=\"worker\",deployment_environment_name=\"demo\"}",
          "instant": false,
          "legendFormat": "worker slot {{worker_slot}} {{signal}} size",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_telemetry_queue_capacity_ratio{job=\"application-otel\",service_name=\"worker\",deployment_environment_name=\"demo\"}",
          "instant": false,
          "legendFormat": "worker slot {{worker_slot}} {{signal}} capacity",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API required family missing",
      "description": "A positive result identifies an up API target without prl_telemetry_queue_capacity{service=\"api\",signal=\"stdout\"}.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "(up{job=\"api\"} == 1) unless on(job,instance) prl_telemetry_queue_capacity{service=\"api\",signal=\"stdout\"}",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent API and worker events",
      "description": "Native OTLP event bodies are finite event names; IDs and diagnostic fields remain structured metadata.",
      "datasource": {
        "type": "loki",
        "uid": "prl-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "prl-loki"
          },
          "expr": "{service_name=~\"api|worker\",deployment_environment_name=\"demo\"} | keep service_name,trace_id,request_id,severity",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
