  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "description": "Static interpretation notes.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "No DB or pool series is unknown, not zero utilization. API gauges retain their direct Prometheus names. Worker unit-1 gauge conversions carry the _ratio suffix and still represent absolute values."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Checked-out connections",
      "description": "Separate API scrape from worker OTLP scrape; worker values with _ratio are absolute counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_db_pool_checked_out{job=\"api\"}",
          "instant": false,
          "legendFormat": "API",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_db_pool_checked_out_ratio{job=\"application-otel\",service_name=\"worker\",deployment_environment_name=\"demo\"}",
          "instant": false,
          "legendFormat": "worker slot {{worker_slot}}",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Idle connections",
