    {
      "id": 5,
      "type": "timeseries",
      "title": "Database failures (5m)",
      "description": "Finite database failure reasons only; increase is absent when no DB failure series has been observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prl-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(job,reason) (increase(prl_db_failures_total[5m]))",
          "instant": false,
          "legendFormat": "{{job}} {{reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "API error logs and trace drilldown",
      "description": "Native OTLP API event and structured metadata. TraceID links to Tempo; request ID and finite error code remain available in log details.",
      "datasource": {
        "type": "loki",
        "uid": "prl-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "prl-loki"
          },
          "expr": "{service_name=\"api\",deployment_environment_name=\"demo\"} |= \"http.server.request\" | status >= 500 | keep route,method,status,error_code,request_id,trace_id",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
