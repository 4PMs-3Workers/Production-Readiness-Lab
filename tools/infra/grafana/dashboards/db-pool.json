          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_db_pool_idle_ratio{job=\"application-otel\",service_name=\"worker\",deployment_environment_name=\"demo\"}",
          "instant": false,
          "legendFormat": "worker slot {{worker_slot}}",
          "range": true,
          "refId": "B"
        }
