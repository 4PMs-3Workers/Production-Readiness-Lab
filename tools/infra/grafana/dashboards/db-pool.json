        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prl-prometheus"
          },
          "editorMode": "code",
          "expr": "prl_db_pool_overflow_ratio{job=\"application-otel\",service_name=\"worker\",deployment_environment_name=\"demo\"}",
          "instant": false,
