# Nonsecret pointers only. Supply private files on each independently managed host.
PRL_OFFHOST_CONFIG=/etc/prl/offhost/config.json
PRL_OFFHOST_CREDENTIALS=/etc/prl/offhost/credentials.json
PRL_OFFHOST_IDENTITY=/etc/prl-recovery/age-identity.txt
PRL_OFFHOST_AGE=/opt/prl/age/age
PRL_OFFHOST_ESCROW=/var/lib/prl/offhost/release-escrow
PRL_OFFHOST_LOCAL_STORE=/srv/prl-backups
# Scheduled mode requires this exact directory to back PRL_BACKUP_VOLUME via bind.
# Upload hosts need the public age recipient in config, not the private identity.
# Recovery hosts must have independent credentials/key/CA access, without the source.
