# PRIVATE external file, chmod 0600. Replace placeholders outside the repository.
DATABASE_URL=mysql+asyncmy://prl_backup:EXTERNAL_URL_ENCODED_PASSWORD@mysql/prl
BACKUP_STORE=/backups
BACKUP_MAX_SECONDS=600
BACKUP_QUERY_SECONDS=30
BACKUP_LOCK_SECONDS=3
BACKUP_MAX_BYTES=536870912
BACKUP_MIN_FREE_BYTES=67108864
BACKUP_KEEP_COUNT=7
BACKUP_MAX_AGE_DAYS=30
# Restore only: separate explicitly created empty database, external credentials.
