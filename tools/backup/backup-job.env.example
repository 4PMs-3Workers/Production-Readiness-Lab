# Nonsecret paths/identity only. systemd EnvironmentFile uses absolute paths.
PRL_BACKUP_PROJECT=prl-demo
PRL_IMAGE_TAG=REVIEWED_IMMUTABLE_TAG
PRL_SOURCE_SHA=REVIEWED_FULL_40_CHARACTER_GIT_SHA
PRL_HTTP_PORT=8080
PRL_DB_ENV_FILE=/etc/prl/db.env
PRL_RUNTIME_ENV_FILE=/etc/prl/runtime.env
PRL_MIGRATION_ENV_FILE=/etc/prl/migration.env
PRL_SEED_ENV_FILE=/etc/prl/seed.env
PRL_BACKUP_ENV_FILE=/etc/prl/backup.env
PRL_BACKUP_VOLUME=prl-backup-storage
PRL_BACKUP_JOB_SECONDS=1300
